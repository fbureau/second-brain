#!/usr/bin/env bash
#
# Second Brain — pre-commit vault validation
#
# Runs 3 checks on staged Markdown notes:
#   1. AI-first compliance  — frontmatter + `ai-first: true` + "For future Claude" preamble
#   2. Append-only history  — refuse deleting notes, timeline entries, or protected
#                             markers in 02-people/ and 05-decisions/
#   3. Frontmatter sanity   — well-formed `---` fences (+ wikilink warnings)
#
# Checks run against the STAGED content (the blobs being committed), not the
# working tree — partial stages (`git add -p`) are validated as committed.
#
# Bypass (use sparingly, for intentional history edits):
#   git commit --no-verify
#
set -uo pipefail

# Match note files inside the numbered vault folders, anywhere in the tree
# (works whether the vault is at repo root or nested under vault-starter/).
VAULT_NOTE_RE='(^|/)0[0-7]-(inbox|daily|people|projects|meetings|decisions|knowledge|archive)/.+\.md$'
APPEND_ONLY_RE='(^|/)0(2-people|5-decisions)/.+\.md$'
ARCHIVE_RE='(^|/)07-archive/'

errors=0
warnings=0

# core.quotePath=off: otherwise non-ASCII filenames (accented people names) come
# back C-quoted and silently fail the regex matches, skipping every check.
# --no-renames: a rename decomposes into A + D so both sides get checked.
git_ls() { git -c core.quotePath=off diff --cached --name-only --no-renames --diff-filter="$1"; }

staged="$(git_ls ACM)"
staged_deleted="$(git_ls D)"

# Rename-aware map (old<TAB>new), used to allow legitimate moves to 07-archive/.
renames="$(git -c core.quotePath=off diff --cached --name-status -M90 | grep -E '^R' | cut -f2,3 || true)"

# ---------------------------------------------------------------------------
# Check 1 + 3 — AI-first compliance & frontmatter sanity (on staged content)
# ---------------------------------------------------------------------------
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  [[ "$(basename "$f")" == "README.md" ]] && continue
  [[ "$f" =~ $VAULT_NOTE_RE ]] || continue

  # Read the staged blob, not the working-tree copy.
  content="$(git show ":$f" 2>/dev/null)" || continue

  # Frontmatter must open on line 1 and have a closing fence.
  # ([[:space:]]* tolerates a trailing CR on CRLF files, same as the fence count.)
  first_line="$(head -n 1 <<< "$content")"
  fence_count="$(grep -c '^---[[:space:]]*$' <<< "$content")"
  if ! [[ "$first_line" =~ ^---[[:space:]]*$ ]] || [[ "$fence_count" -lt 2 ]]; then
    echo "✗ [frontmatter] $f — missing or unterminated YAML frontmatter (--- ... ---)"
    errors=$((errors + 1))
    continue
  fi

  # ai-first: true must be present.
  if ! grep -Eq '^ai-first:[[:space:]]*true[[:space:]]*$' <<< "$content"; then
    echo "✗ [ai-first] $f — frontmatter missing 'ai-first: true'"
    errors=$((errors + 1))
  fi

  # "For future Claude" preamble must be present.
  if ! grep -Eq '^##[[:space:]]+For future Claude[[:space:]]*$' <<< "$content"; then
    echo "✗ [preamble] $f — missing '## For future Claude' preamble"
    errors=$((errors + 1))
  fi

  # Warn on obviously broken wikilinks: empty [[ ]].
  if grep -Eq '\[\[[[:space:]]*\]\]' <<< "$content"; then
    echo "⚠ [wikilink] $f — contains an empty wikilink [[ ]]"
    warnings=$((warnings + 1))
  fi
done <<< "$staged"

# ---------------------------------------------------------------------------
# Check 2 — Append-only history on 02-people/ and 05-decisions/
#
# 2a. Deleting a whole note there is the most destructive diff of all — block it,
#     unless it's a move into 07-archive/ (the sanctioned way to retire a note).
# 2b. Block diffs that DELETE (or rewrite) a dated timeline header or a protected
#     marker. Editing Compiled truth / Open threads / frontmatter is still allowed.
# ---------------------------------------------------------------------------
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  [[ "$f" =~ $APPEND_ONLY_RE ]] || continue
  [[ "$(basename "$f")" == "README.md" ]] && continue

  dest="$(printf '%s\n' "$renames" | awk -F'\t' -v old="$f" '$1 == old { print $2 }')"
  if [[ -n "$dest" ]]; then
    if [[ "$dest" =~ $ARCHIVE_RE ]]; then
      continue  # move to 07-archive/ — allowed
    fi
    echo "✗ [append-only] $f — renamed/moved to '$dest'; append-only notes may only move to 07-archive/"
    errors=$((errors + 1))
  else
    echo "✗ [append-only] $f — deletes a note in an append-only folder (move to 07-archive/ instead)"
    errors=$((errors + 1))
  fi
done <<< "$staged_deleted"

while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  [[ "$f" =~ $APPEND_ONLY_RE ]] || continue

  removed="$(git -c core.quotePath=off diff --cached -U0 --no-renames -- "$f" | grep -E '^-' | grep -Ev '^---')"

  # Removed/rewritten dated timeline entry header — daily ("### 2026-05-20 — ...")
  # or backfilled monthly ("### 2026-03 (Backfilled — aggregated)").
  if grep -Eq '^-#{2,4}[[:space:]]*[0-9]{4}-[0-9]{2}(-[0-9]{2})?' <<< "$removed"; then
    echo "✗ [append-only] $f — deletes or rewrites a dated timeline entry (history is append-only)"
    errors=$((errors + 1))
  fi

  # Removed protected marker — including suffixed forms like
  # "(Backfilled — aggregated)" and "(Backfilled, no transcript)".
  if grep -Eq '^-.*\((auto-logged|Backfilled)[^)]*\)' <<< "$removed"; then
    echo "✗ [append-only] $f — removes a protected (auto-logged)/(Backfilled) marker"
    errors=$((errors + 1))
  fi
done <<< "$staged"

# Deleting a vault note anywhere else: not blocked, but the rules say archive instead.
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  [[ "$f" =~ $APPEND_ONLY_RE ]] && continue
  [[ "$(basename "$f")" == "README.md" ]] && continue
  if [[ "$f" =~ $VAULT_NOTE_RE ]] && ! [[ "$f" =~ $ARCHIVE_RE ]]; then
    dest="$(printf '%s\n' "$renames" | awk -F'\t' -v old="$f" '$1 == old { print $2 }')"
    [[ -n "$dest" ]] && continue  # a move, not a deletion
    echo "⚠ [delete] $f — deleting a vault note; prefer moving it to 07-archive/"
    warnings=$((warnings + 1))
  fi
done <<< "$staged_deleted"

# ---------------------------------------------------------------------------
echo
if [[ "$warnings" -gt 0 ]]; then
  echo "⚠ $warnings warning(s)."
fi
if [[ "$errors" -gt 0 ]]; then
  echo "✗ $errors error(s). Commit blocked."
  echo "  Fix the notes above, or — for an intentional history edit — use: git commit --no-verify"
  exit 1
fi

echo "✓ Vault checks passed."
exit 0
