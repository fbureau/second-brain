# --- Obsidian vault noise (if the vault lives in this repo, at any depth) ---
**/.obsidian/workspace
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/cache
**/.obsidian/.DS_Store
.trash/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# --- Secrets & local config (never commit) ---
.env
.env.*
*.local
secrets.*
**/credentials.json
.claude/settings.local.json

# --- Scratch / temp ---
tmp/
*.tmp
*.log

# NOTE: vault notes themselves (00-inbox/ ... 07-archive/) are NOT ignored.
# Versioning the vault is the whole point — the append-only history lives in Git.

# --- Python bytecode (hermes plugin / tests) ---
__pycache__/
*.pyc
